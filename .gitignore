*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.sw?

# ====================== VSCode 专用缓存 ======================
# .vscode/
# 注意：如果你不要保存tasks.json/launch.json到仓库，打开上面一行注释，同时注释或删除下面这三行
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/c_cpp_properties.json
.vscode/.env
.vscode/extensions.json
.vscode/settings.jsonc
.vscode/**/.git
.vscode/.cache
.vscode/ipch
.vscode/.suo
.vscode/*.log
*.code-workspace
.env
